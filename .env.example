# Solana RPC endpoint used for reading mainnet state and historical swaps.
# An archival-capable provider (Helius, Triton) is required for historical replay.
HELIUS_API_KEY=
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Devnet endpoint used for deployment testing.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
